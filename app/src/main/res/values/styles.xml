<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Jarvis.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/jarvis_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Jarvis.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/jarvis_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Jarvis.Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#6D869B</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Jarvis.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jarvis_text</item>
        <item name="android:textColorHint">#42566A</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
